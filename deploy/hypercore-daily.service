# /etc/systemd/system/hypercore-daily.service
#
# One daily HyperCore run (incremental extract -> Iceberg lift -> summary/alert).
# Started by hypercore-daily.timer; systemd never starts a second instance while
# one is still running, and the runner's own lock file covers manual starts.
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hypercore-daily.timer
#   sudo systemctl start hypercore-daily.service      # run once, now
#   journalctl -u hypercore-daily -f                  # logs
[Unit]
Description=HyperCore scheduled extract (Hyperliquid -> lakehouse)
After=network-online.target
Wants=network-online.target
# Standalone layout: the file:// warehouse lives on the NAS. Without this line a
# Persistent= timer firing right after boot could run before the mount is up and
# write the lake onto the root disk (HL_WAREHOUSE_MOUNT in the env file is the
# second guard: the run refuses to start when the path is not on that mount).
RequiresMountsFor=/mnt/blueblocx
# alert when the unit fails before the run could write its own summary (preflight
# FAIL, crash, kill); a run that reported itself keeps the notifier quiet
OnFailure=hypercore-failure@%n.service

[Service]
Type=oneshot
User=hypercore
Group=hypercore
WorkingDirectory=/opt/blueblocx-hyperliquid
EnvironmentFile=/etc/hypercore/hypercore.env
ExecStartPre=/opt/blueblocx-hyperliquid/.venv/bin/python -m blueblocx_hyperliquid.preflight --iceberg --s3 --wallets-file /etc/hypercore/wallets.txt
ExecStart=/opt/blueblocx-hyperliquid/.venv/bin/python -m blueblocx_hyperliquid.daily --wallets-file /etc/hypercore/wallets.txt --iceberg --s3-backfill
# a 24h window of S3 hour files for market-maker wallets takes ~35 min; whales with
# a lazy full-ledger pull add ~10 min. Anything past this is stuck, not slow.
TimeoutStartSec=4h
# SIGTERM at TimeoutStartSec must leave the runner time to drop the wallet in flight
# and write its summary (+ webhook, heartbeat); the 90 s default is too short under
# a slow API. Hourly: start <= :12 + 50 min + 3 min -> SIGKILL <= :05, next tick :10.
TimeoutStopSec=3min
# S3 hour files are parsed one at a time (<= ~330 MB decompressed, ~1.5 GB RSS); the
# staged l1 CSV is merged in memory on every upsert (~1 KB per row: 45 days of a
# market-maker wallet is several GB) and the lift keeps the touched partitions' keys.
MemoryMax=8G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# the state dir AND the warehouse directory on the NAS: ProtectSystem=strict mounts
# everything else read-only, so a lift to /mnt/blueblocx fails without the 2nd path
ReadWritePaths=/var/lib/hypercore /mnt/blueblocx/hypercore
StateDirectory=hypercore

[Install]
WantedBy=multi-user.target
