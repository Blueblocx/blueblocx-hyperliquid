# /etc/systemd/system/hypercore-maintenance.service
# Nightly: compact closed, fragmented partitions (one commit per table, bounded by the
# next hourly tick minus a minute - v1.8.0), expire Iceberg snapshots older than 7 days
# and make sure the metadata-retention properties are set. Shares the run lock with the
# scheduled extract and is skipped by a running lift (exit 3 = SuccessExitStatus, not
# a failure); genuine compaction/expire/property errors exit 1 and show as a failed unit.
[Unit]
Description=HyperCore lake maintenance (compact closed partitions, expire snapshots)
After=network-online.target
RequiresMountsFor=/mnt/blueblocx
# a boot catch-up (both Persistent= timers fire together) or a hand start must not
# collide with the data run on the lock: order after hypercore-daily.service
After=hypercore-daily.service

[Service]
Type=oneshot
# exit 3 = maintenance found the run lock held by a data run and yielded: not a failure
SuccessExitStatus=3
User=hypercore
Group=hypercore
WorkingDirectory=/opt/blueblocx-hyperliquid
EnvironmentFile=/etc/hypercore/hypercore.env
ExecStart=/opt/blueblocx-hyperliquid/.venv/bin/python -m blueblocx_hyperliquid.maintenance --expire-days 7 --compact
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypercore /mnt/blueblocx/hypercore
