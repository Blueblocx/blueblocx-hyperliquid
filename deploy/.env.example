# HyperCore pipeline — environment template.
# Copy to <repo>/.env (chmod 600, never commit) or load with systemd EnvironmentFile=.
# Every variable is documented in hl_poc/config.py (ENV_VARS); `python -m hl_poc.preflight`
# validates this file without printing secrets.

# ---- Hyperliquid Info API -------------------------------------------------------------
HL_INFO_URL=https://api.hyperliquid.xyz/info
# 1200/min per IP is shared by EVERY poller on this host's egress IP (TS platform-backend
# included). 600 leaves half for the others; raise only if this host polls alone.
HL_WEIGHT_BUDGET=600
HL_HTTP_TIMEOUT=30

# ---- state ----------------------------------------------------------------------------
HL_OUT_DIR=/var/lib/hypercore
HL_WALLETS_FILE=/etc/hypercore/wallets.txt
# staged CSV rows older than this are dropped after a successful Iceberg lift (>= 31)
HL_RETENTION_DAYS=45

# ---- daily runner ---------------------------------------------------------------------
HL_LOG_LEVEL=INFO
HL_LOG_JSON=1
HL_LOCK_STALE_HOURS=12
# Slack / Discord incoming webhook; POSTed when a run has problems (and on success if =1)
HL_ALERT_WEBHOOK_URL=
HL_ALERT_ON_SUCCESS=0

# ---- S3 node data: fills beyond the Info API cap (Requester Pays = billed to YOU) ------
# Dedicated IAM user, policy = s3:GetObject on arn:aws:s3:::hl-mainnet-node-data/* only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Iceberg catalog: choose ONE of the two blocks -------------------------------------
# (A) STANDALONE host (e.g. server4090-2): no Nessie, no MinIO/SeaweedFS. Catalog rows in a
#     small PostgreSQL on the local disk, table data as plain files on the NAS mount.
#     Install PostgreSQL, `CREATE DATABASE hl_catalog;` + a role, mkdir the warehouse dir.
HL_CATALOG_URI=postgresql+psycopg2://hl:CHANGE_ME@localhost:5432/hl_catalog
WAREHOUSE=file:///mnt/blueblocx/hypercore/warehouse
# (B) SHARED atlas lake over the LAN: Nessie REST + the S3 store it fronts. Leave (A) empty.
#NESSIE_URI=http://<olympus-lan-ip>:19120/iceberg
#NESSIE_BRANCH=main
#NESSIE_TOKEN=
#WAREHOUSE=s3://warehouse
#S3_ENDPOINT=http://<olympus-lan-ip>:9000
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_REGION=us-east-1
# Neither set = local SQLite dev catalog under HL_OUT_DIR/iceberg (not for production).

# ---- HyperEVM (optional, separate namespace) -------------------------------------------
HYPEREVM_RPC_URL=
