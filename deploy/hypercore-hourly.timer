# /etc/systemd/system/hypercore-hourly.timer
#
# Hourly cadence: the same hypercore-daily.service, fired at minute 10 of every
# hour (Hyperliquid's hourly funding settles on the hour; the 1h watermark
# overlap re-pulls the boundary). Use INSTEAD of hypercore-daily.timer, and
# shorten the service timeout so an overrun can never collide with the next
# tick:
#
#   sudo cp deploy/hypercore-hourly.timer /etc/systemd/system/
#   sudo mkdir -p /etc/systemd/system/hypercore-daily.service.d
#   sudo cp deploy/hourly-override.conf /etc/systemd/system/hypercore-daily.service.d/hourly.conf
#   sudo systemctl daemon-reload
#   sudo systemctl disable --now hypercore-daily.timer 2>/dev/null
#   sudo systemctl enable --now hypercore-hourly.timer
#
# Capacity: one run spends ~165 API weight per light wallet (+ items/20 for fills;
# ~750-1,200 for a market maker); at HL_WEIGHT_BUDGET=900 that is ~270 light
# wallets per 50-minute run, ~360 at 1200. Above that, trim the slow-changing
# pulls or add an egress IP (docs/DEPLOY.md, "Hourly cadence").
#
# The list itself: pinned wallets + the leaderboard tracked set (HL_TRACKED_SOURCE,
# tracked.py). Set HL_RUN_SOFT_DEADLINE_MIN=35 so a list that outgrows the slot defers
# its tail to the next tick (rotating order) instead of being killed at 50 min with
# nothing saved. Auto-tracked wallets onboard themselves with a --days 2 window; a
# PINNED market-maker-class wallet (10k-fill cap) still needs an S3 backfill by hand,
# because one wallet's backfill cannot be interrupted by the soft deadline:
#   python -m blueblocx_hyperliquid.extract --wallet 0x... --days 2 --incremental --iceberg --s3-backfill
[Unit]
Description=Run hypercore-daily.service every hour

[Timer]
OnCalendar=*-*-* *:10:00 UTC
RandomizedDelaySec=120
Persistent=true
Unit=hypercore-daily.service

[Install]
WantedBy=timers.target
